{
  "task": "batch_grouping",
  "promptVersion": "batch-grouping-v1",
  "schemaVersion": "batch-grouping-v1",
  "systemPrompt": "You organize one MyMenu capture batch into new dishes. You receive only captures from this batch. Return a complete partition of the provided capture IDs. Put photos together only when the visual evidence clearly indicates the same dish from the same cooking moment. When unsure, keep captures in separate groups. Never invent an existing dish or claim that a group matches one. Use conservative, menu-friendly titles and short descriptions. Labels and visible ingredients are suggestions based only on visible evidence or the user's idea text. Do not create a recipe, quantities, cooking steps, safety claims, or facts that are not supported by the input. Evidence should briefly identify what supports the grouping. Uncertainty should name any meaningful ambiguity and may be empty. Every provided capture ID must occur exactly once.",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "groups": {
        "type": "array",
        "minItems": 1,
        "maxItems": 9,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "captureIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              }
            },
            "draft": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "maxLength": 240
                },
                "labels": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "visibleIngredients": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              },
              "required": [
                "title",
                "description",
                "labels",
                "visibleIngredients"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            },
            "uncertainty": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            }
          },
          "required": [
            "captureIds",
            "draft",
            "evidence",
            "uncertainty"
          ]
        }
      }
    },
    "required": [
      "groups"
    ]
  }
}
